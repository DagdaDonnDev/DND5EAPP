__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller build output -- regenerated by packaging/windows/build_exe.*,
# not source. Previously got committed by accident (90MB+ of binaries),
# which is most of why this repo's .git directory ballooned.
build/
dist/

# Android build cache (Qt + Python compiled for ARM64, several GB) --
# buildozer keeps it in .buildozer/ next to dnd_app/ui_android/buildozer.spec.
# Deleting it forces a full 30-45 minute rebuild; never commit it.
.buildozer/
dnd_app/ui_android/bin/
*.apk
*.apk.idsig
*.aab
*.ap_
.gradle/

# deployment/ is this machine's own Android build kit: older build caches,
# the Qt jars taken from the wheels (jar/) and p4a's local recipes
# (recipes/: setup_buildozer_spec makes the PySide6 and shiboken6 ones
# from packaging/android/recipes/). All regenerable by setup_buildozer_spec,
# except...
deployment/.buildozer/
deployment/jar/
deployment/recipes/*
# ...the hand-patched python3 recipe that disables broken 3.14 patches in
# p4a 2026.05.09: not regenerable from the wheels, and losing it means
# re-disabling 6 patches by hand. It isn't in the repo yet -- commit it
# from the machine that has it.
!deployment/recipes/python3/
!deployment/recipes/python3/__init__.py

# dnd_app/ui_android/buildozer.spec is hand-edited and IS committed; the
# backups setup_buildozer_spec leaves beside it, and a stray copy at the
# repo root, are not.
dnd_app/ui_android/buildozer.spec.bak.*
/buildozer.spec

# The Android PySide6/Shiboken6 wheels are committed at the repo root;
# setup_buildozer_spec downloads any that are missing into
# packaging/android/wheels/, which isn't committed -- nor are the Qt jars
# it takes out of the wheel (packaging/android/jars/).
packaging/android/wheels/
packaging/android/jars/

# The key that signs the APK. first_time_setup.sh copies an old computer's
# debug.keystore from packaging/android/ into WSL; it never goes in git.
*.keystore
*.jks

# Stray backup files build scripts drop next to what they patch (e.g. an
# icon-stripping step's *.pre-strip.bak).
*.pre-strip.bak

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
